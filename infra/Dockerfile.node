# One image for the API, the worker and the migration job.
# Build:  docker build -f infra/Dockerfile.node -t bookmarker-node .
# Run:    the command picks the service (see docker-compose files).
FROM node:22-bookworm-slim AS deps
RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/gate/package.json packages/gate/
COPY packages/mail/package.json packages/mail/
COPY packages/shared/package.json packages/shared/
COPY packages/db/prisma packages/db/prisma
COPY packages/db/prisma.config.ts packages/db/
RUN pnpm install --frozen-lockfile --filter "@bookmarker/api..." --filter "@bookmarker/worker..." --filter "@bookmarker/db..."

FROM deps AS runtime
COPY packages packages
COPY apps/api apps/api
COPY apps/worker apps/worker
RUN pnpm --filter @bookmarker/db generate
ENV NODE_ENV=production
USER node
EXPOSE 4000
# Default: the API. The worker and migrate services override the command.
CMD ["pnpm", "--filter", "@bookmarker/api", "start"]
