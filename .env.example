# BookMarker configuration. Copy to .env and fill in. Never commit real values.
# Staging/production values live encrypted in infra/secrets/ (SOPS + age; see docs/runbook.md).

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# Public URL of the web app (used for links in emails, OAuth redirects, CORS/origin checks)
APP_URL=http://localhost:3000
# Public URL of the API as seen by browsers (same origin in production via Caddy: APP_URL + /api)
API_URL=http://localhost:4000
PORT=4000
# Web app (dev): where Next sends /api/* and where the browser opens the socket.
# In production both are the same origin through Caddy, so leave NEXT_PUBLIC_SOCKET_URL empty there.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- Data -------------------------------------------------------------------
DATABASE_URL=postgresql://bookmarker:bookmarker@localhost:5432/bookmarker
# Tests use a separate database (created by docker compose): bookmarker_test
REDIS_URL=redis://localhost:6379

# --- Auth (FR-1, SEC-1..3) --------------------------------------------------
# Google OAuth client (console.cloud.google.com -> APIs & Services -> Credentials).
# Leave empty to disable Google sign-in; magic links still work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random bytes, used to sign the short-lived OAuth state cookie. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-64-hex-chars
# Set to true behind HTTPS (staging/production) so cookies get the Secure flag.
COOKIE_SECURE=false

# --- Email (plain SMTP, so any provider works) -------------------------------
# Dev/staging: Mailpit catches everything at http://localhost:8025
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="BookMarker <hello@bookmarker.local>"

# --- Ops (optional) ----------------------------------------------------------
# Sentry-protocol DSN (GlitchTip self-hosted or Sentry). Empty = disabled.
SENTRY_DSN=
LOG_LEVEL=info
# Sign-in requests per IP per 15 minutes (SEC-6: 10). Only the e2e tests raise it.
# RATE_LIMIT_AUTH=10
