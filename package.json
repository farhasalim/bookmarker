{
  "name": "bookmarker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:leak": "pnpm --filter @bookmarker/api --filter @bookmarker/worker --workspace-concurrency=1 test:leak",
    "test:e2e": "pnpm --filter @bookmarker/web test:e2e",
    "db:migrate": "pnpm --filter @bookmarker/db migrate:dev",
    "db:deploy": "pnpm --filter @bookmarker/db migrate:deploy",
    "db:seed": "pnpm --filter @bookmarker/db seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
